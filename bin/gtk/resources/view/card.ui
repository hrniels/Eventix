<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.10"/>
  <template class="EventixEventCard" parent="GtkButton">
    <style><class name="ev_event"/></style>
    <property name="child">
      <object class="GtkBox">
        <property name="spacing">4</property>
        <child>
          <object class="GtkBox" id="response">
            <property name="visible">false</property>
            <style><class name="ev_response_bar"/></style>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="text">
            <property name="xalign">0</property>
            <property name="yalign">0</property>
            <property name="ellipsize">end</property>
            <property name="hexpand">true</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="indicators">
            <property name="spacing">3</property>
            <property name="valign">start</property>
            <property name="margin-top">2</property>
            <property name="margin-end">2</property>
            <child>
              <object class="GtkImage" id="recurrence">
                <property name="resource">/io/github/hrniels/Eventix/gtk/icons/arrow-clockwise-symbolic.svg</property>
                <property name="pixel-size">16</property>
                <property name="visible">false</property>
              </object>
            </child>
            <child>
              <object class="GtkImage" id="exception">
                <property name="resource">/io/github/hrniels/Eventix/gtk/icons/pencil-symbolic.svg</property>
                <property name="pixel-size">16</property>
                <property name="visible">false</property>
              </object>
            </child>
            <child>
              <object class="GtkImage" id="alarm">
                <property name="resource">/io/github/hrniels/Eventix/gtk/icons/alarm-symbolic.svg</property>
                <property name="pixel-size">16</property>
                <property name="visible">false</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
