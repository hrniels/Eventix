<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.10"/>
  <template class="EventixEventCard" parent="GtkButton">
    <property name="overflow">hidden</property>
    <style><class name="ev_event"/></style>
    <property name="child">
      <object class="GtkBox" id="content">
        <property name="spacing">4</property>
        <child>
          <object class="GtkBox" id="response">
            <property name="visible">false</property>
            <style><class name="ev_response_bar"/></style>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="text">
            <property name="xalign">0</property>
            <property name="yalign">0</property>
            <property name="ellipsize">end</property>
            <property name="hexpand">true</property>
          </object>
        </child>
        <child>
          <object class="EventixEventIndicators" id="indicators">
            <property name="valign">start</property>
            <property name="margin-top">2</property>
            <property name="margin-end">2</property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
