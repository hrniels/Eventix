<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.10"/>
  <!-- Repeated grid children are instantiated as needed for the displayed month. -->
  <object class="GtkLabel" id="weekday">
    <property name="ellipsize">end</property>
    <style><class name="ev_month_weekday"/></style>
  </object>
  <object class="GtkLabel" id="day">
    <property name="xalign">0</property>
    <property name="ellipsize">end</property>
  </object>
  <object class="GtkButton" id="week">
    <property name="action-name">win.show-week</property>
    <property name="cursor">
      <object class="GdkCursor">
        <property name="name">pointer</property>
      </object>
    </property>
    <style><class name="ev_month_week_number"/></style>
  </object>
  <object class="GtkAdjustment" id="adjustment"/>
  <object class="GtkScrolledWindow" id="scroll">
    <property name="hscrollbar-policy">never</property>
    <property name="vscrollbar-policy">external</property>
    <property name="vadjustment">adjustment</property>
    <property name="child">
      <object class="EventixMonthWeekContent" id="content"/>
    </property>
  </object>
  <!-- The external scrollbar occupies the gutter, preserving header alignment. -->
  <object class="GtkScrollbar" id="scrollbar">
    <property name="orientation">vertical</property>
    <property name="adjustment">adjustment</property>
    <property name="visible">false</property>
  </object>
</interface>
