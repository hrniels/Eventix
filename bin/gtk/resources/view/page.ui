<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.10"/>
  <!-- User-facing labels are populated through Eventix's TOML locale system in Rust. -->
  <template class="EventixCalendarPage" parent="GtkBox">
    <property name="orientation">vertical</property>
    <child>
      <object class="GtkBox">
        <property name="spacing">8</property>
        <style><class name="ev_calendar_toolbar"/></style>
        <child>
          <object class="GtkBox">
            <property name="hexpand">true</property>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="spacing">0</property>
            <style><class name="ev_view_switch"/></style>
            <child>
              <object class="GtkToggleButton" id="week_view">
                <property name="active">true</property>
              </object>
            </child>
            <child>
              <object class="GtkToggleButton" id="month_view">
                <property name="group">week_view</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="reload">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="action-name">win.reload</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkGrid">
        <property name="column-homogeneous">true</property>
        <property name="column-spacing">8</property>
        <property name="vexpand">true</property>
        <child>
          <object class="GtkFrame">
            <layout>
              <property name="column">0</property>
              <property name="column-span">4</property>
            </layout>
            <property name="hexpand">true</property>
            <property name="vexpand">true</property>
            <style>
              <class name="ev_panel_frame"/>
              <class name="ev_calendar_panel"/>
            </style>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkCenterBox" id="header">
                    <style><class name="ev_panel_header"/></style>
                    <child type="start">
                      <object class="GtkBox">
                        <property name="spacing">4</property>
                        <property name="valign">center</property>
                        <child>
                          <object class="GtkButton" id="previous">
                            <property name="icon-name">go-previous-symbolic</property>
                            <property name="action-name">win.previous</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="today">
                            <property name="action-name">win.today</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="next">
                            <property name="icon-name">go-next-symbolic</property>
                            <property name="action-name">win.next</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkMenuButton" id="picker">
                            <property name="icon-name">x-office-calendar-symbolic</property>
                            <property name="popover">
                              <object class="GtkPopover">
                                <property name="child">
                                  <object class="GtkCalendar" id="calendar">
                                    <property name="show-week-numbers">true</property>
                                  </object>
                                </property>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child type="center">
                      <object class="GtkLabel" id="title">
                        <property name="xalign">0.5</property>
                        <property name="valign">center</property>
                        <property name="ellipsize">end</property>
                        <style><class name="ev_panel_title"/></style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkSeparator"/>
                </child>
                <child>
                  <object class="GtkStack" id="stack">
                    <property name="hexpand">true</property>
                    <property name="vexpand">true</property>
                    <property name="vhomogeneous">false</property>
                    <property name="hhomogeneous">false</property>
                    <child>
                      <object class="GtkScrolledWindow" id="weekly_content">
                        <property name="vexpand">true</property>
                        <property name="vscrollbar-policy">never</property>
                        <property name="child">
                          <object class="EventixWeekContent" id="weekly"/>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow" id="monthly_content">
                        <property name="vexpand">true</property>
                        <property name="overlay-scrolling">false</property>
                        <property name="child">
                          <object class="EventixMonthGrid" id="monthly">
                            <property name="hexpand">true</property>
                            <property name="vexpand">true</property>
                            <property name="overflow">hidden</property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="EventixSidebar" id="sidebar">
            <layout><property name="column">4</property></layout>
            <property name="vexpand">true</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="status">
        <property name="xalign">0</property>
        <property name="selectable">true</property>
        <property name="wrap">true</property>
        <style><class name="ev_calendar_status"/></style>
      </object>
    </child>
  </template>
</interface>
