<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.10"/>
  <template class="EventixWeekContent" parent="GtkBox">
    <property name="orientation">vertical</property>
    <child>
      <object class="GtkBox">
        <child><object class="GtkBox" id="gutter"/></child>
        <child>
          <object class="GtkBox" id="headers">
            <property name="homogeneous">true</property>
            <property name="hexpand">true</property>
            <style><class name="ev_day_headers"/></style>
            <child>
              <object class="GtkBox">
                <property name="spacing">6</property>
                <property name="halign">center</property>
                <property name="hexpand">true</property>
                <child>
                  <object class="GtkLabel" id="monday">
                    <property name="hexpand">false</property>
                    <property name="ellipsize">end</property>
                  </object>
                </child>
                <child>
                  <object class="GtkImage" id="monday_time_change">
                    <property name="resource">@RESOURCE_PREFIX@/icons/clock-history-symbolic.svg</property>
                    <property name="pixel-size">18</property>
                    <property name="valign">center</property>
                    <property name="visible">false</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="spacing">6</property>
                <property name="halign">center</property>
                <property name="hexpand">true</property>
                <child>
                  <object class="GtkLabel" id="tuesday">
                    <property name="hexpand">false</property>
                    <property name="ellipsize">end</property>
                  </object>
                </child>
                <child>
                  <object class="GtkImage" id="tuesday_time_change">
                    <property name="resource">@RESOURCE_PREFIX@/icons/clock-history-symbolic.svg</property>
                    <property name="pixel-size">18</property>
                    <property name="valign">center</property>
                    <property name="visible">false</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="spacing">6</property>
                <property name="halign">center</property>
                <property name="hexpand">true</property>
                <child>
                  <object class="GtkLabel" id="wednesday">
                    <property name="hexpand">false</property>
                    <property name="ellipsize">end</property>
                  </object>
                </child>
                <child>
                  <object class="GtkImage" id="wednesday_time_change">
                    <property name="resource">@RESOURCE_PREFIX@/icons/clock-history-symbolic.svg</property>
                    <property name="pixel-size">18</property>
                    <property name="valign">center</property>
                    <property name="visible">false</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="spacing">6</property>
                <property name="halign">center</property>
                <property name="hexpand">true</property>
                <child>
                  <object class="GtkLabel" id="thursday">
                    <property name="hexpand">false</property>
                    <property name="ellipsize">end</property>
                  </object>
                </child>
                <child>
                  <object class="GtkImage" id="thursday_time_change">
                    <property name="resource">@RESOURCE_PREFIX@/icons/clock-history-symbolic.svg</property>
                    <property name="pixel-size">18</property>
                    <property name="valign">center</property>
                    <property name="visible">false</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="spacing">6</property>
                <property name="halign">center</property>
                <property name="hexpand">true</property>
                <child>
                  <object class="GtkLabel" id="friday">
                    <property name="hexpand">false</property>
                    <property name="ellipsize">end</property>
                  </object>
                </child>
                <child>
                  <object class="GtkImage" id="friday_time_change">
                    <property name="resource">@RESOURCE_PREFIX@/icons/clock-history-symbolic.svg</property>
                    <property name="pixel-size">18</property>
                    <property name="valign">center</property>
                    <property name="visible">false</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="spacing">6</property>
                <property name="halign">center</property>
                <property name="hexpand">true</property>
                <child>
                  <object class="GtkLabel" id="saturday">
                    <property name="hexpand">false</property>
                    <property name="ellipsize">end</property>
                  </object>
                </child>
                <child>
                  <object class="GtkImage" id="saturday_time_change">
                    <property name="resource">@RESOURCE_PREFIX@/icons/clock-history-symbolic.svg</property>
                    <property name="pixel-size">18</property>
                    <property name="valign">center</property>
                    <property name="visible">false</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="spacing">6</property>
                <property name="halign">center</property>
                <property name="hexpand">true</property>
                <child>
                  <object class="GtkLabel" id="sunday">
                    <property name="hexpand">false</property>
                    <property name="ellipsize">end</property>
                  </object>
                </child>
                <child>
                  <object class="GtkImage" id="sunday_time_change">
                    <property name="resource">@RESOURCE_PREFIX@/icons/clock-history-symbolic.svg</property>
                    <property name="pixel-size">18</property>
                    <property name="valign">center</property>
                    <property name="visible">false</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkSeparator"/>
    </child>
    <child>
      <object class="GtkOverlay">
        <property name="hexpand">true</property>
        <child>
          <object class="GtkScrolledWindow" id="all_day_scroll">
            <property name="hscrollbar-policy">never</property>
            <property name="vscrollbar-policy">automatic</property>
            <property name="overlay-scrolling">true</property>
            <property name="min-content-height">30</property>
            <property name="max-content-height">60</property>
            <property name="propagate-natural-height">true</property>
            <property name="child">
              <object class="EventixAllDayStrip" id="all_day">
                <property name="hexpand">true</property>
                <property name="overflow">hidden</property>
              </object>
            </property>
          </object>
        </child>
        <child type="overlay">
          <object class="GtkBox" id="all_day_top_fade">
            <property name="height-request">16</property>
            <property name="valign">start</property>
            <property name="hexpand">true</property>
            <property name="can-target">false</property>
            <property name="visible">false</property>
            <style><class name="ev_scroll_fade_top"/></style>
          </object>
        </child>
        <child type="overlay">
          <object class="GtkBox" id="all_day_bottom_fade">
            <property name="height-request">16</property>
            <property name="valign">end</property>
            <property name="hexpand">true</property>
            <property name="can-target">false</property>
            <property name="visible">false</property>
            <style><class name="ev_scroll_fade_bottom"/></style>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkSeparator">
        <style><class name="ev_week_separator"/></style>
      </object>
    </child>
    <child>
      <object class="GtkScrolledWindow" id="scroll">
        <property name="vexpand">true</property>
        <property name="hscrollbar-policy">never</property>
        <property name="vscrollbar-policy">automatic</property>
        <property name="overlay-scrolling">true</property>
        <property name="child">
          <object class="EventixTimedGrid" id="timed">
            <property name="hexpand">true</property>
            <property name="overflow">hidden</property>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
