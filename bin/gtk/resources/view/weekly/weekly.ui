<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.10"/>
  <!-- User-facing labels are populated through Eventix's TOML locale system in Rust. -->
  <template class="EventixWeekPage" parent="GtkBox">
    <property name="orientation">vertical</property>
    <child>
      <object class="GtkBox">
        <property name="spacing">8</property>
        <style><class name="ev_week_toolbar"/></style>
        <child>
          <object class="GtkButton" id="previous">
            <property name="icon-name">go-previous-symbolic</property>
            <property name="action-name">win.previous</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="today">
            <property name="action-name">win.today</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="next">
            <property name="icon-name">go-next-symbolic</property>
            <property name="action-name">win.next</property>
          </object>
        </child>
        <child>
          <object class="GtkMenuButton" id="picker">
            <property name="icon-name">x-office-calendar-symbolic</property>
            <property name="popover">
              <object class="GtkPopover">
                <property name="child">
                  <object class="GtkCalendar" id="calendar">
                    <property name="show-week-numbers">true</property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="title">
            <property name="hexpand">true</property>
            <property name="xalign">0</property>
            <property name="ellipsize">end</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="reload">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="action-name">win.reload</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkScrolledWindow">
        <property name="vexpand">true</property>
        <property name="vscrollbar-policy">never</property>
        <property name="child">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkBox">
                <child><object class="GtkBox" id="gutter"/></child>
                <child>
                  <object class="GtkBox" id="headers">
                    <property name="homogeneous">true</property>
                    <property name="hexpand">true</property>
                    <style><class name="ev_day_headers"/></style>
                    <child>
                      <object class="GtkLabel" id="monday">
                        <property name="hexpand">true</property>
                        <property name="ellipsize">end</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="tuesday">
                        <property name="hexpand">true</property>
                        <property name="ellipsize">end</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="wednesday">
                        <property name="hexpand">true</property>
                        <property name="ellipsize">end</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="thursday">
                        <property name="hexpand">true</property>
                        <property name="ellipsize">end</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="friday">
                        <property name="hexpand">true</property>
                        <property name="ellipsize">end</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="saturday">
                        <property name="hexpand">true</property>
                        <property name="ellipsize">end</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="sunday">
                        <property name="hexpand">true</property>
                        <property name="ellipsize">end</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="all_day_label">
                <property name="xalign">0</property>
                <style><class name="ev_all_day_label"/></style>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">never</property>
                <property name="vscrollbar-policy">always</property>
                <property name="overlay-scrolling">false</property>
                <property name="min-content-height">30</property>
                <property name="max-content-height">120</property>
                <property name="propagate-natural-height">true</property>
                <property name="child">
                   <object class="EventixAllDayStrip" id="all_day">
                    <property name="hexpand">true</property>
                    <property name="overflow">hidden</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow" id="scroll">
                <property name="vexpand">true</property>
                <property name="hscrollbar-policy">never</property>
                <property name="vscrollbar-policy">always</property>
                <property name="overlay-scrolling">false</property>
                <property name="child">
                   <object class="EventixTimedGrid" id="timed">
                    <property name="hexpand">true</property>
                    <property name="overflow">hidden</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="status">
        <property name="xalign">0</property>
        <property name="selectable">true</property>
        <property name="wrap">true</property>
        <style><class name="ev_week_status"/></style>
      </object>
    </child>
  </template>
</interface>
