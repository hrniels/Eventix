<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.10"/>
  <object class="GtkToggleButton" id="calendar">
    <style><class name="ev_list_calendar"/></style>
    <property name="child">
      <object class="GtkDrawingArea" id="dot">
        <property name="halign">center</property>
        <property name="valign">center</property>
        <style><class name="ev_list_calendar_dot"/></style>
      </object>
    </property>
  </object>
</interface>
