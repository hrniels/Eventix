<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="EventixStatusBar" parent="GtkBox">
    <property name="spacing">4</property>
    <style><class name="ev_calendar_status"/></style>
    <child>
      <object class="GtkMenuButton" id="language_button">
        <style><class name="ev_status_button"/></style>
        <property name="valign">center</property>
        <property name="direction">up</property>
        <property name="child"><object class="GtkImage" id="language_icon"/></property>
        <property name="popover">
          <object class="GtkPopover" id="language_popup">
            <property name="position">top</property>
            <property name="halign">start</property>
            <property name="has-arrow">false</property>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">4</property>
                <child><object class="GtkButton" id="english"/></child>
                <child><object class="GtkButton" id="german"/></child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkMenuButton" id="history_button">
        <style><class name="ev_status_button"/></style>
        <property name="icon-name">document-open-recent-symbolic</property>
        <property name="valign">center</property>
        <property name="sensitive">false</property>
        <property name="direction">up</property>
        <property name="popover">
          <object class="GtkPopover" id="history_popup">
            <property name="position">top</property>
            <property name="halign">start</property>
            <property name="has-arrow">false</property>
            <style><class name="ev_activity_history"/></style>
            <child>
              <object class="GtkScrolledWindow" id="history_scroll">
                <property name="hscrollbar-policy">never</property>
                <property name="width-request">600</property>
                <property name="min-content-width">600</property>
                <property name="max-content-height">320</property>
                <property name="propagate-natural-height">true</property>
                <child>
                  <object class="GtkListView" id="history">
                    <property name="focusable">false</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="status">
        <property name="margin-start">8</property>
        <property name="xalign">0</property>
        <property name="selectable">true</property>
        <property name="single-line-mode">true</property>
        <property name="ellipsize">end</property>
        <property name="hexpand">true</property>
      </object>
    </child>
    <child>
      <object class="GtkProgressBar" id="sync_progress">
        <property name="visible">false</property>
        <property name="width-request">160</property>
        <property name="valign">center</property>
        <property name="show-text">true</property>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="cancel_sync">
        <property name="visible">false</property>
        <property name="icon-name">window-close-symbolic</property>
        <property name="valign">center</property>
        <style><class name="ev_cancel_sync"/></style>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="version">
        <property name="margin-start">8</property>
        <property name="xalign">1</property>
        <property name="selectable">true</property>
      </object>
    </child>
  </template>
</interface>
