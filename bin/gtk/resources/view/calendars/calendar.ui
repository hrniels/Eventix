<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkFrame" id="calendar">
    <style><class name="ev_management_calendar"/></style>
    <child>
      <object class="GtkBox">
        <property name="spacing">8</property>
        <style><class name="ev_management_card"/></style>
        <child>
          <object class="GtkBox" id="heading">
            <property name="spacing">8</property>
            <property name="hexpand">true</property>
            <property name="valign">center</property>
          </object>
        </child>
        <child><object class="GtkBox" id="actions">
          <property name="spacing">4</property>
          <property name="halign">end</property>
          <property name="valign">center</property>
        </object></child>
      </object>
    </child>
  </object>
</interface>
