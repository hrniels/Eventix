<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.10"/>
  <template class="EventixTimePicker" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="spacing">8</property>
    <style><class name="ev_time_picker"/></style>
    <child>
      <object class="GtkBox">
        <property name="spacing">4</property>
        <property name="halign">center</property>
        <child>
          <object class="GtkButton" id="hours">
            <property name="focus-on-click">false</property>
            <property name="focusable">false</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="label">:</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="minutes_button">
            <property name="focus-on-click">false</property>
            <property name="focusable">false</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkFixed" id="face">
        <style><class name="ev_time_picker_face"/></style>
      </object>
    </child>
  </template>
</interface>
